        "    for word in inputs:\n",
        "        if word == \"relational\":\n",
        "            steps = \"1. Remove '-ional' -> relat\\n2. Add '-e' -> relate\"\n",
        "            inter = \"relat -> relate\"\n",
        "            stem = \"relate\"\n",
        "        elif word == \"relation\":\n",
        "            steps = \"1. Remove '-ion' -> relat\\n2. Add '-e' -> relate\"\n",
        "            inter = \"relat -> relate\"\n",
        "            stem = \"relate\"\n",
        "        elif word == \"relate\":\n",
        "            steps = \"No suffixes to remove (Base form)\"\n",
        "            inter = \"relate\"\n",
        "            stem = \"relate\"\n",
