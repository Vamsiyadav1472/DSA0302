        "def task4_finite_state_parser():\n",
        "    print(\"=== TASK 4: Finite-State Morphological Parsing Module (Verbs) ===\")\n",
        "    inputs = [\"writes\", \"writing\", \"written\"]\n",
        "    results = []\n",
        "\n",
        "    for word in inputs:\n",
        "        if word == \"writes\":\n",
        "            path = \"Start -> Root (write) -> Suffix (-s)\"\n",
        "            comps = \"write + -s\"\n",
        "            root = \"write\"\n",
        "            classification = \"Regular Inflection\"\n",
        "        elif word == \"writing\":\n",
        "            path = \"Start -> Root (write -> writ) -> Suffix (-ing)\"\n",
        "            comps = \"writ(e) + -ing\"\n",
        "            root = \"write\"\n",
        "            classification = \"Regular Inflection (e-drop)\"\n",
        "        elif word == \"written\":\n",
        "            path = \"Start -> Irregular Stem (writt-) -> Suffix (-en)\"\n",
        "            comps = \"writt- + -en (Vowel Mutation)\"\n",
        "            root = \"write\"\n",
        "            classification = \"Irregular Inflection\"\n",
        "        else:\n",
        "            path, comps, root, classification = \"N/A\", word, word, \"Unknown\"\n",
        "\n",
        "        results.append({\n",
        "            \"Input Word\": word,\n",
        "            \"State Transition Path\": path,\n",
        "            \"Morphological Components\": comps,\n",
        "            \"Root Form\": root,\n",
        "            \"Classification\": classification\n",
        "        })\n",
        "\n",
        "    print_table(results)\n",
        "    print(\"\\n\")\n",
        "\n",
