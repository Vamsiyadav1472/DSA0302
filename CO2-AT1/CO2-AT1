      "source": [
        "import re\n",
        "def print_table(data):\n",
        "    if not data:\n",
        "        return\n",
        "    keys = list(data[0].keys())\n",
        "    col_widths = {key: max(len(key), max(len(str(row[key])) for row in data)) for key in keys}\n",
        "\n",
        "    header = \" | \".join(key.ljust(col_widths[key]) for key in keys)\n",
        "    separator = \"-+-\".join(\"-\" * col_widths[key] for key in keys)\n",
        "    print(header)\n",
        "    print(separator)\n",
        "\n",
        "    for row in data:\n",
        "        print(\" | \".join(str(row[key]).ljust(col_widths[key]) for key in keys))\n",
        "\n",
        "def task1_document_indexing():\n",
        "    print(\"=== TASK 1: Document Indexing Morphological Analysis Pipeline ===\")\n",
        "    inputs = [\"connected\", \"connecting\", \"connection\"]\n",
        "    results = []\n",
        "\n",
        "    for word in inputs:\n",
        "        if word == \"connected\":\n",
        "            root, suffix, t_type = \"connect\", \"-ed\", \"Inflectional\"\n",
        "        elif word == \"connecting\":\n",
        "            root, suffix, t_type = \"connect\", \"-ing\", \"Inflectional\"\n",
        "        elif word == \"connection\":\n",
        "            root, suffix, t_type = \"connect\", \"-ion\", \"Derivational\"\n",
        "        else:\n",
        "            root, suffix, t_type = word, \"\", \"None\"\n",
        "\n",
        "        results.append({\n",
        "            \"Original Word\": word,\n",
        "            \"Parsed Structure\": f\"{root} + {suffix}\",\n",
        "            \"Suffix Type\": t_type,\n",
        "            \"Normalized Output\": root\n",
        "        })\n",
        "\n",
        "    print_table(results)\n",
        "    print(\"\\n\")\n",
        "\n",
        "task1_document_indexing()"
      ]
    },
