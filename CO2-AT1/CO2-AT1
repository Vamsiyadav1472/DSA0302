        "            t_type = \"Derivational (Negation)\"\n",
        "        elif word == \"happiness\":\n",
        "            prefix, root, suffix = \"-\", \"happy\", \"-ness\"\n",
        "            t_type = \"Derivational (Noun formation)\"\n",
        "        elif word == \"happily\":\n",
        "            prefix, root, suffix = \"-\", \"happy\", \"-ly\"\n",
        "            t_type = \"Derivational (Adverb formation)\"\n",
        "        else:\n",
        "            prefix, root, suffix = \"-\", word, \"-\"\n",
        "            t_type = \"-\"\n",
        "\n",
        "        results.append({\n",
        "            \"Original Word\": word,\n",
        "            \"Prefix\": prefix,\n",
        "            \"Root\": root,\n",
